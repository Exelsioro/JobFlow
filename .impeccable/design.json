  "narrative": {
    "northStar": "Local workbench",
    "overview": "Operate mode: readable records, inline editing and explicit feedback. The interface uses a quiet green and neutral palette for a daytime desktop workspace, adapting the same controls to mobile web. This records the implemented design, not a claim that the complete product is finished.",
    "keyCharacteristics": [
      "Tables carry records; forms carry configuration.",
      "Primary actions remain distinct from secondary and row actions.",
      "Empty and unsupported states explain the available next step."
    ],
    "rules": [
      {
        "name": "The Status Truth Rule",
        "body": "Success styling confirms the operation actually completed; queued work must remain described as queued. Unsupported features are labelled explicitly.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do use API-backed records and counts.",
      "Do keep unsupported capabilities explicit.",
      "Do retain visible keyboard focus and labelled native controls.",
      "Do scope profile-owned records to the selected working profile."
    ],
    "donts": [
      "Don't present queued work as completed.",
      "Don't add fabricated users, testimonials or decorative records.",
      "Don't require remote fonts or trackers for the local interface."
